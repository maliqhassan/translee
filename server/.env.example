# Transee backend configuration.
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# None of these values may ever be sent to, or embedded in, the mobile app.

# Azure AI Translator credential. Create a Translator resource in the Azure
# portal; the key and region are on its "Keys and Endpoint" page.
# Required unless TRANSLATION_PROVIDER=fake.
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_REGION=

# Provider to route through: "azure" (default) or "fake".
# "fake" is a deterministic offline stand-in for local development and tests.
TRANSLATION_PROVIDER=azure

# HTTP port. Defaults to 8787.
PORT=8787

# Requests allowed per client per window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
