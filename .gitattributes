# Normalise to LF in the repo and on checkout, so Prettier's `endOfLine: lf`
# and .editorconfig hold on every platform regardless of core.autocrlf.
* text=auto eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
